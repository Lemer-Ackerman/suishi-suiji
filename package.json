{
  "name": "suishi-suiji",
  "productName": "随时 · 随记",
  "version": "1.1.0",
  "description": "随时 · 随记：置顶的聊天式桌面记事本，随时记录，自动保存。",
  "author": "Lemer-Ackerman",
  "private": true,
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.cjs",
    "test:e2e": "playwright test",
    "check": "node --check src/main.cjs && node --check src/renderer.js && node --check src/core.cjs && node --check src/preload.cjs && node --check src/entries.cjs && node --check src/startup.cjs && node --check src/security.cjs",
    "pack:mac": "electron-builder --mac --publish never",
    "pack:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.65.1"
  },
  "build": {
    "appId": "com.lemer.daynote",
    "productName": "随时 · 随记",
    "artifactName": "Suishi-Suiji-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "随时 · 随记",
      "artifactName": "Suishi-Suiji-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Suishi-Suiji-${version}-win-${arch}-portable.${ext}"
    }
  }
}
